    "%@ · %@" : {
      "comment" : "Joins parts of an event's description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ · %2$@"
          }
        }
      }
    },
    "%@ – %@" : {
      "comment" : "A range of days",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ – %2$@"
          }
        }
      }
    },
